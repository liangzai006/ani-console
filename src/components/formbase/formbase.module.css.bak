.page {
  --form-surface: var(--color-bg-white, var(--color-bg-2));
  display: grid;
  grid-template-rows: 24px minmax(0, 1fr);
  height: calc(100vh - var(--topbar-height, 56px) - 32px);
  min-height: 560px;
  gap: 12px;
  color: var(--color-text-1);
  font-size: 14px;
  letter-spacing: 0;
}

.breadcrumbRow {
  display: flex;
  align-items: center;
  min-width: 0;
  overflow: hidden;
  gap: 4px;
  white-space: nowrap;
}

.backButton {
  flex: 0 0 28px;
  width: 28px;
  height: 28px;
  padding: 0;
  color: var(--color-text-2);
}

.backButton:hover {
  background: transparent;
  color: rgb(var(--primary-6));
}

.breadcrumbs {
  min-width: 0;
  overflow: hidden;
  color: var(--color-text-3);
  line-height: 22px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.breadcrumbLink,
.breadcrumbText,
.breadcrumbCurrent {
  color: inherit;
  text-decoration: none;
}

.breadcrumbLink:hover {
  color: rgb(var(--primary-6));
}

.breadcrumbCurrent {
  display: inline;
  margin: 0;
  color: var(--color-text-1);
  font-size: 14px;
  font-weight: 700;
  line-height: 22px;
}

.surface {
  display: grid;
  grid-template-rows: minmax(0, 1fr) 64px;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  border-radius: 8px;
  background: var(--form-surface);
  box-shadow: 0 2px 8px rgba(0, 73, 128, 0.05);
}

.form {
  min-width: 0;
  min-height: 0;
  overflow: hidden;
}

.scrollArea {
  box-sizing: border-box;
  height: 100%;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  padding: 32px 40px;
  scrollbar-gutter: stable;
}

.section + .section {
  margin-top: 36px;
}

.sectionTitle {
  display: flex;
  align-items: center;
  margin: 0 0 20px;
  gap: 12px;
  color: var(--color-text-1);
  font-size: 16px;
  font-weight: 700;
  line-height: 24px;
}

.sectionAccent {
  width: 4px;
  height: 20px;
  border-radius: 1px;
  background: rgb(var(--primary-6));
}

.sectionContent {
  max-width: 760px;
}

.form :global(.arco-form-item) {
  margin-bottom: 20px;
}

.form :global(.arco-form-item:last-child) {
  margin-bottom: 0;
}

.form :global(.arco-form-item-label-col) {
  flex: 0 0 160px;
  max-width: 160px;
  padding-right: 24px;
}

.form :global(.arco-form-item-wrapper-col) {
  flex: 0 1 520px;
  max-width: 520px;
}

.form :global(.arco-input-wrapper),
.form :global(.arco-textarea-wrapper),
.form :global(.arco-select-view),
.form :global(.arco-input-number) {
  border-color: var(--color-border-2);
  background-color: var(--form-surface);
}

.form :global(.arco-input-wrapper:hover),
.form :global(.arco-textarea-wrapper:hover),
.form :global(.arco-select-view:hover),
.form :global(.arco-input-number:hover) {
  border-color: var(--color-border-3);
}

.form :global(.arco-input-focus),
.form :global(.arco-textarea-focus),
.form :global(.arco-select-view-focus),
.form :global(.arco-input-number-focus) {
  border-color: rgb(var(--primary-6));
  box-shadow: 0 0 0 2px var(--color-primary-light-1);
}

.form :global(.arco-input-wrapper-disabled),
.form :global(.arco-textarea-wrapper-disabled),
.form :global(.arco-select-view-disabled),
.form :global(.arco-input-number-disabled) {
  background-color: var(--color-fill-1);
}

.footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  padding: 0 32px;
  border-top: 1px solid var(--color-border-1);
  background: var(--form-surface);
}

@media (max-width: 768px) {
  .page {
    min-height: 480px;
  }

  .scrollArea {
    padding: 24px 20px;
  }

  .section + .section {
    margin-top: 28px;
  }

  .form :global(.arco-form-item) {
    display: block;
  }

  .form :global(.arco-form-item-label-col),
  .form :global(.arco-form-item-wrapper-col) {
    max-width: none;
  }

  .form :global(.arco-form-item-label-col) {
    padding-right: 0;
  }

  .footer {
    padding: 0 20px;
  }
}
